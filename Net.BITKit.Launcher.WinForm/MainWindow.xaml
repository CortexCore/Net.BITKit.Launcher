<Window x:Class="Net.BITKit.Launcher.WinForm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BITFALL Launcher"
        Width="1280"
        Height="720"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#080A08"
        FontFamily="Bahnschrift, Microsoft YaHei UI"
        Foreground="#E9E4D4"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="LauncherStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Root" Background="#11140F">
        <Image x:Name="HeroImage" Stretch="UniformToFill" />
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#FA050705" Offset="0" />
                    <GradientStop Color="#EA070907" Offset="0.31" />
                    <GradientStop Color="#78070806" Offset="0.60" />
                    <GradientStop Color="#43050605" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0">
                    <GradientStop Color="#D9050604" Offset="0" />
                    <GradientStop Color="#00050604" Offset="0.48" />
                    <GradientStop Color="#60050604" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="74" />
                <RowDefinition Height="*" />
                <RowDefinition Height="56" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#B5070907" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="258" />
                        <ColumnDefinition Width="92" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                        <Grid Width="34" Height="34">
                            <Polygon Points="17,3 31,29 3,29" Stroke="#D8D6CB" StrokeThickness="1.4" Fill="Transparent" />
                            <Polygon Points="17,10 24,24 10,24" Stroke="#777A70" StrokeThickness="1" Fill="Transparent" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="19,0,0,0">
                        <TextBlock x:Name="ProductNameText" Text="PROJECT B" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="FIELD OPERATIONS LAUNCHER" Margin="15,3,0,0" Foreground="#9A9D93" FontFamily="Cascadia Mono" FontSize="9" />
                    </StackPanel>
                    <UniformGrid Grid.Column="2" Columns="3">
                        <Button x:Name="InstallPhaseButton" Style="{StaticResource PhaseButton}">
                            <Grid><StackPanel VerticalAlignment="Center"><TextBlock Text="01" HorizontalAlignment="Center" FontFamily="Cascadia Mono" FontSize="11" /><TextBlock Text="部署" HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="11" /></StackPanel><Border x:Name="InstallPhaseLine" Height="2" Background="{StaticResource AccentBrush}" VerticalAlignment="Bottom" Margin="14,0" /></Grid>
                        </Button>
                        <Button x:Name="SyncPhaseButton" Style="{StaticResource PhaseButton}">
                            <Grid><StackPanel VerticalAlignment="Center"><TextBlock Text="02" HorizontalAlignment="Center" FontFamily="Cascadia Mono" FontSize="11" /><TextBlock Text="同步" HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="11" /></StackPanel><Border x:Name="SyncPhaseLine" Height="2" Background="{StaticResource AccentBrush}" VerticalAlignment="Bottom" Margin="14,0" /></Grid>
                        </Button>
                        <Button x:Name="ReadyPhaseButton" Style="{StaticResource PhaseButton}">
                            <Grid><StackPanel VerticalAlignment="Center"><TextBlock Text="03" HorizontalAlignment="Center" FontFamily="Cascadia Mono" FontSize="11" /><TextBlock Text="就绪" HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="11" /></StackPanel><Border x:Name="ReadyPhaseLine" Height="2" Background="{StaticResource AccentBrush}" VerticalAlignment="Bottom" Margin="14,0" /></Grid>
                        </Button>
                    </UniformGrid>
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button Style="{StaticResource WindowButton}" Content="—" Click="MinimizeButton_Click" />
                        <Button Style="{StaticResource WindowButton}" Content="×" FontSize="18" Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" Background="#94060806" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <TextBlock Text="ATLAS / BITKIT" Foreground="#94978D" FontFamily="Cascadia Mono" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,26,0,0"><TextBlock.LayoutTransform><RotateTransform Angle="-90" /></TextBlock.LayoutTransform></TextBlock>
                    <Border Width="1" Height="240" Margin="0,92,0,0" VerticalAlignment="Top"><Border.Background><LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1"><GradientStop Color="#A0D2B160" Offset="0" /><GradientStop Color="#00D2B160" Offset="1" /></LinearGradientBrush></Border.Background></Border>
                    <TextBlock x:Name="BuildText" Text="BUILD READY" Foreground="{StaticResource AccentBrush}" FontFamily="Cascadia Mono" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,34"><TextBlock.LayoutTransform><RotateTransform Angle="-90" /></TextBlock.LayoutTransform></TextBlock>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Grid.Column="1" Margin="46,28,46,34">
                <Grid.RowDefinitions><RowDefinition Height="26" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Width="30" Height="1" Fill="{StaticResource AccentBrush}" />
                    <Rectangle Width="8" Height="1" Fill="{StaticResource AccentBrush}" Margin="7,0,0,0" />
                    <TextBlock Text="SECURE DEPLOYMENT CHANNEL / CN-01" Margin="10,0,0,0" Foreground="#B0B3A7" FontFamily="Cascadia Mono" FontSize="10" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /><ColumnDefinition Width="455" /></Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,12">
                        <StackPanel x:Name="InstallHero">
                            <TextBlock Text="INITIAL DEPLOYMENT" Foreground="{StaticResource AccentBrush}" FontFamily="Cascadia Mono" FontSize="11" />
                            <TextBlock Text="部署你的" Margin="0,15,0,0" FontSize="64" FontWeight="Bold" />
                            <TextBlock Text="作战终端" Margin="0,-10,0,0" FontSize="64" FontWeight="Light" Foreground="#B9B6AA" />
                            <TextBlock Text="安装完整游戏资源，并为后续增量更新建立本地校验索引。" Width="430" Margin="0,20,0,0" Foreground="#C0C2B8" FontSize="14" LineHeight="24" TextWrapping="Wrap" HorizontalAlignment="Left" />
                        </StackPanel>
                        <StackPanel x:Name="SyncHero" Visibility="Collapsed">
                            <TextBlock Text="RESOURCE SYNCHRONIZATION" Foreground="{StaticResource AccentBrush}" FontFamily="Cascadia Mono" FontSize="11" />
                            <TextBlock Text="正在建立" Margin="0,15,0,0" FontSize="64" FontWeight="Bold" />
                            <TextBlock Text="前线资源" Margin="0,-10,0,0" FontSize="64" FontWeight="Light" Foreground="#B9B6AA" />
                            <TextBlock x:Name="SyncDescriptionText" Text="所有文件在进入游戏目录前均经过完整性验证。" Width="430" Margin="0,20,0,0" Foreground="#C0C2B8" FontSize="14" LineHeight="24" TextWrapping="Wrap" HorizontalAlignment="Left" />
                        </StackPanel>
                        <StackPanel x:Name="ReadyHero" Visibility="Collapsed">
                            <TextBlock Text="OPERATION READY" Foreground="{StaticResource AccentBrush}" FontFamily="Cascadia Mono" FontSize="11" />
                            <TextBlock Text="区域已开放" Margin="0,15,0,0" FontSize="58" FontWeight="Bold" />
                            <TextBlock Text="等待进入" Margin="0,-8,0,0" FontSize="64" FontWeight="Light" Foreground="#B9B6AA" />
                            <TextBlock x:Name="ReadyDescriptionText" Text="本地资源完整，当前版本与远端部署清单一致。" Width="430" Margin="0,20,0,0" Foreground="#C0C2B8" FontSize="14" LineHeight="24" TextWrapping="Wrap" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Column="2" x:Name="InstallPanel" VerticalAlignment="Bottom" Background="#E10A0D0A" BorderBrush="#AADED2AC" BorderThickness="0,1,0,0" Padding="25,23,25,24">
                        <StackPanel>
                            <Grid><TextBlock Text="安装位置" FontSize="13" /><TextBlock Text="INSTALL LOCATION" HorizontalAlignment="Right" Style="{StaticResource MicroLabel}" /></Grid>
                            <Border Height="48" Margin="0,11,0,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="#4A000000">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="78" /></Grid.ColumnDefinitions><TextBox x:Name="InstallPathTextBox" Text="D:\Games\BITFALL" Background="Transparent" BorderThickness="0" Foreground="#D0D3C7" FontFamily="Cascadia Mono" FontSize="12" VerticalContentAlignment="Center" Padding="13,0" CaretBrush="{StaticResource AccentBrush}" /><Button Grid.Column="1" Style="{StaticResource GhostButton}" BorderThickness="1,0,0,0" Content="更改" Click="BrowseButton_Click" /></Grid>
                            </Border>
                            <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Border Grid.Column="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,1,1" Padding="0,11,10,11"><StackPanel><TextBlock Text="下载大小" Style="{StaticResource MicroLabel}" /><TextBlock x:Name="DownloadSizeText" Text="--" Style="{StaticResource MetricValue}" /></StackPanel></Border><Border Grid.Column="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,1,1" Padding="10,11"><StackPanel><TextBlock Text="所需空间" Style="{StaticResource MicroLabel}" /><TextBlock x:Name="RequiredSpaceText" Text="--" Style="{StaticResource MetricValue}" /></StackPanel></Border><Border Grid.Column="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,1" Padding="10,11,0,11"><StackPanel><TextBlock Text="校验方式" Style="{StaticResource MicroLabel}" /><TextBlock Text="SHA-256" Style="{StaticResource MetricValue}" /></StackPanel></Border></Grid>
                            <CheckBox x:Name="DesktopShortcutCheckBox" IsChecked="True" Content="创建桌面快捷方式" Foreground="#B9BCB1" FontSize="12" Margin="0,15,0,0" />
                            <TextBlock x:Name="InstallStatusText" Text="正在读取安装信息" Foreground="#B6D49B" FontSize="11" Margin="0,13,0,0" />
                            <TextBlock x:Name="InstallDetailText" Text="正在连接安全部署通道" Foreground="#8E9288" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                            <Button x:Name="DeployButton" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0" IsEnabled="False" Click="DeployButton_Click"><Grid Margin="22,0"><TextBlock x:Name="DeployButtonText" Text="开始部署" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" /><TextBlock Text="INSTALL GAME" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Cascadia Mono" FontSize="10" /></Grid></Button>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" x:Name="SyncPanel" Visibility="Collapsed" VerticalAlignment="Bottom" Background="#E10A0D0A" BorderBrush="#AADED2AC" BorderThickness="0,1,0,0" Padding="27,25,27,22">
                        <StackPanel>
                            <TextBlock x:Name="SyncStatusText" Text="正在检查更新" Foreground="#A4A89E" FontSize="12" />
                            <Grid Margin="0,3,0,0"><TextBlock x:Name="ProgressValueText" Text="0%" FontSize="46" FontWeight="Bold" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,7"><TextBlock x:Name="DownloadedText" Text="0 MiB" Foreground="{StaticResource AccentBrush}" FontFamily="Cascadia Mono" FontSize="10" /><TextBlock x:Name="TotalBytesText" Text=" / --" Foreground="#92968C" FontFamily="Cascadia Mono" FontSize="10" /></StackPanel></Grid>
                            <Grid Height="5" Margin="0,17,0,23" Background="#302C2921"><Border x:Name="ProgressFill" Width="0" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left" /><Border Width="1" Height="11" Background="#66E9E4D4" HorizontalAlignment="Left" Margin="302,0,0,0" /></Grid>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="112" /><ColumnDefinition Width="82" /></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="当前任务" Style="{StaticResource MicroLabel}" /><TextBlock x:Name="CurrentFileText" Text="等待更新服务" Style="{StaticResource MetricValue}" FontSize="10" TextTrimming="CharacterEllipsis" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="下载速度" Style="{StaticResource MicroLabel}" /><TextBlock x:Name="SpeedText" Text="--" Style="{StaticResource MetricValue}" FontSize="10" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="文件进度" Style="{StaticResource MicroLabel}" /><TextBlock x:Name="FileProgressText" Text="--" Style="{StaticResource MetricValue}" FontSize="10" /></StackPanel></Grid>
                            <TextBlock x:Name="SyncDetailText" Text="正在连接安全更新通道" Foreground="#8E9288" FontSize="10" Margin="0,16,0,0" TextTrimming="CharacterEllipsis" />
                            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="88" /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions><Button x:Name="CancelButton" Grid.Column="0" Height="48" Style="{StaticResource GhostButton}" Content="取消" Click="CancelButton_Click" /><Button x:Name="SyncPrimaryButton" Grid.Column="2" Height="48" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="SyncPrimaryButton_Click"><Grid Margin="18,0"><TextBlock x:Name="SyncPrimaryText" Text="正在检查" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" /><TextBlock x:Name="SyncPrimaryCaption" Text="PLEASE WAIT" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Cascadia Mono" FontSize="9" /></Grid></Button></Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" x:Name="ReadyPanel" Visibility="Collapsed" VerticalAlignment="Bottom" Background="#E10A0D0A" BorderBrush="#AADED2AC" BorderThickness="0,1,0,0" Padding="27,24,27,22">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"><Grid Width="24" Height="24" Margin="0,0,10,0"><Ellipse Width="9" Height="9" Fill="#A9C78C" /><Ellipse Width="19" Height="19" Stroke="#33A9C78C" StrokeThickness="5" /></Grid><StackPanel><TextBlock Text="SYSTEM STATUS" Style="{StaticResource MicroLabel}" /><TextBlock x:Name="ReadyStatusText" Text="全部系统就绪" FontSize="14" FontWeight="Bold" Margin="0,3,0,0" /></StackPanel></StackPanel>
                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,17,0,19" />
                            <Button x:Name="ReadyPrimaryButton" Height="94" Style="{StaticResource PrimaryButton}" Click="ReadyPrimaryButton_Click"><Grid><StackPanel VerticalAlignment="Center" Margin="24,0,72,0"><TextBlock x:Name="ReadyPrimaryText" Text="开始行动" FontSize="25" FontWeight="Bold" /><TextBlock x:Name="ReadyPrimaryCaption" Text="LAUNCH APPLICATION" FontFamily="Cascadia Mono" FontSize="10" Margin="0,6,0,0" /></StackPanel><Border Width="68" HorizontalAlignment="Right" BorderBrush="#4011130E" BorderThickness="1,0,0,0"><TextBlock Text="↗" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid></Button>
                            <Grid Margin="0,17,0,0"><TextBlock x:Name="VersionText" Text="版本  --" Foreground="#90948A" FontSize="11" /><TextBlock x:Name="FileCountText" Text="文件  --" Foreground="#90948A" FontSize="11" HorizontalAlignment="Center" /><TextBlock Text="状态  VERIFIED" Foreground="#B7BAAF" FontFamily="Cascadia Mono" FontSize="10" HorizontalAlignment="Right" /></Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#ED050705" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0"><Ellipse Width="6" Height="6" Fill="#A9C78C" /><TextBlock x:Name="ServiceStatusText" Text="更新服务在线" Margin="9,0,0,0" Foreground="#B2B6AA" FontSize="11" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="AnnouncementTitleText" Text="行动简报" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" /><TextBlock x:Name="AnnouncementContentText" Text="启动器会保持应用为最新版本。" Margin="11,0,0,0" Foreground="#A5A99E" FontSize="11" TextTrimming="CharacterEllipsis" /></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal"><Button x:Name="AnnouncementButton" Style="{StaticResource FooterButton}" Content="公告" Click="AnnouncementButton_Click" /><Button Style="{StaticResource FooterButton}" Content="设置" IsEnabled="False" /><Button x:Name="VerifyButton" Style="{StaticResource FooterButton}" Content="文件校验" Click="VerifyButton_Click" /></StackPanel></Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
